  "description": {
    "en": "Outings from the City of Paris agenda: event counts, next event, widget and alerts.",
    "fr": "Les sorties de l'agenda de la Ville de Paris : compteurs, prochain événement, widget et alertes.",
    "de": "Ausgehtipps der Pariser Stadtagenda: Zähler, nächste Veranstaltung, Widget und Hinweise.",
    "es": "Planes de la agenda de la Ciudad de París: contadores, próximo evento, widget y avisos."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-que-faire-a-paris:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-que-faire-a-paris/main/cover.png",
